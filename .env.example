# EOAT Atlas development database. Copy to a non-versioned environment source.
EOAT_DB_HOST=127.0.0.1
EOAT_DB_PORT=3306
EOAT_DB_NAME=eoat_atlas_dev
EOAT_DB_USER=eoat_atlas_app
EOAT_DB_PASSWORD=replace_me
EOAT_DB_MIGRATION_USER=eoat_atlas_migrator
EOAT_DB_MIGRATION_PASSWORD=replace_me
EOAT_DB_DRIVER=pymysql
EOAT_API_ENVIRONMENT=development
EOAT_API_WRITES_ENABLED=true
EOAT_API_HOST=127.0.0.1
EOAT_API_PORT=8765
EOAT_ATLAS_DATA_BACKEND=mysql_api
EOAT_ATLAS_API_URL=http://127.0.0.1:8765
EOAT_ATLAS_ENVIRONMENT=development
EOAT_ATLAS_WRITES_ENABLED=true
# Ordinary EOAT Atlas use is intentionally unauthenticated. Development
# authentication is invoked only from the Settings Admin button.
EOAT_ATLAS_DEV_IDENTITY=
EOAT_AUTH_PROVIDER=development
EOAT_AUTH_SCOPE=settings_only
EOAT_AUTH_SESSION_MINUTES=5
# IT supplies one selected provider configuration. Keep placeholders non-secret.
EOAT_SAML_METADATA_URL=<placeholder>
EOAT_SAML_ENTITY_ID=<placeholder>
EOAT_SAML_ACS_URL=<placeholder>
EOAT_SAML_USERNAME_CLAIM=<placeholder>
EOAT_SAML_DISPLAY_NAME_CLAIM=<placeholder-optional>
EOAT_SAML_EMAIL_CLAIM=<placeholder-optional>
EOAT_SAML_GROUPS_CLAIM=<placeholder>
EOAT_SAML_CERTIFICATE_FINGERPRINT=<placeholder>
EOAT_SAML_ALLOWED_CLOCK_SKEW_SECONDS=120
EOAT_LDAP_ENABLED=false
# IT-approved canonical production endpoint. The DNS name is round-robin; do
# not replace it with a single directory-controller hostname.
EOAT_LDAP_HOSTS=gwplastics.com
EOAT_LDAP_PORT=636
EOAT_LDAP_USE_LDAPS=true
EOAT_LDAP_CONNECTION_TIMEOUT_SECONDS=5
EOAT_LDAP_OPERATION_TIMEOUT_SECONDS=5
EOAT_LDAP_DISCOVER_NAMING_CONTEXT=true
EOAT_LDAP_BASE_DN=<discovered-or-approved-override>
EOAT_LDAP_USER_SEARCH_BASE=<optional-narrower-base>
EOAT_LDAP_USER_SEARCH_FILTER=<not-used-for-upn-direct-bind>
EOAT_LDAP_GROUP_SEARCH_BASE=<placeholder-optional>
EOAT_LDAP_GROUP_ATTRIBUTE=memberOf
# Leave blank to use the operating-system trust store. A path, if used, must
# be an IT-approved CA bundle; certificate verification is never disabled.
EOAT_LDAP_TRUST_STORE_PATH=
EOAT_LDAP_UPN_SUFFIX=gwplastics.com
EOAT_LDAP_AUTHENTICATION_MODE=upn
# Required before any directory user can administer Settings. Do not invent a group.
EOAT_LDAP_SETTINGS_ADMIN_GROUP=<IT-approved-group-distinguished-name-or-stable-id>
EOAT_LDAP_NESTED_GROUP_RESOLUTION=false
# Reference to an IT-approved server-side secret store; never put the secret here.
EOAT_LDAP_SERVICE_ACCOUNT_SECRET_REFERENCE=<placeholder-optional>
