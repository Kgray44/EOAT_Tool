# Template only. The local rehearsal utility writes real secrets outside the repository.
EOAT_DB_HOST=127.0.0.1
EOAT_DB_PORT=3306
EOAT_DB_NAME=eoat_atlas_staging_local
EOAT_DB_USER=eoat_staging_runtime
EOAT_DB_PASSWORD=REPLACE_OUTSIDE_REPOSITORY
EOAT_DB_MIGRATION_USER=eoat_staging_migrator
EOAT_DB_MIGRATION_PASSWORD=REPLACE_OUTSIDE_REPOSITORY
EOAT_API_ENVIRONMENT=staging_local
EOAT_API_WRITES_ENABLED=false
EOAT_API_PORT=8766
EOAT_ATLAS_DATA_BACKEND=mysql_api
EOAT_ATLAS_API_URL=http://127.0.0.1:8766
EOAT_ATLAS_ENVIRONMENT=staging_local
EOAT_ATLAS_WRITES_ENABLED=false
# IT must select saml or ldap. Unselected fails closed for Settings authentication
# while ordinary EOAT Atlas use remains available without sign-in.
EOAT_AUTH_PROVIDER=unselected
EOAT_AUTH_SCOPE=settings_only
EOAT_AUTH_SESSION_MINUTES=5
EOAT_AUTH_JIT_PROVISIONING=true
