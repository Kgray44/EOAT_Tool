# Installed outside Git as /etc/eoat-atlas/runtime.env (root:eoat-atlas, 0640).
EOAT_API_ENVIRONMENT=production
EOAT_API_WRITES_ENABLED=false
EOAT_API_DEVICE_TOKEN=__SERVER_ONLY_DEVICE_TOKEN__
EOAT_WEB_CONTENT_ROOTS=/mnt/eoat-atlas-media
# Exact Windows/UNC source prefix to approved Debian mount mapping.  Leave []
# when media is unavailable; metadata remains visible and content fails closed.
EOAT_WEB_CONTENT_PATH_MAPPINGS=[]
