# Root-owned configuration for the fixed EOAT onboarding media broker.
# These are installation-owned paths, never browser/API request values.
EOAT_ONBOARDING_STAGING_ROOT=/opt/eoat-atlas/shared/onboarding-staging
EOAT_CANONICAL_MEDIA_ROOT=/var/lib/eoat-atlas/media
EOAT_ONBOARDING_MEDIA_SOCKET=/run/eoat-atlas/onboarding-media.sock
